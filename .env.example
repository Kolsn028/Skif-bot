DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
GUILD_ID=

FAMILY_NAME=Skif Family
EMBED_COLOR=0xB11F2D
BANNER_URL=
FOOTER_TEXT=Skif Family • Management System

CAPT_POINTS=3
MP_POINTS=2
MSH_POINTS=2
TRAINING_POINTS=1
OTHER_POINTS=1
INACTIVITY_DAYS_DEFAULT=3
AUTO_CREATE_CASE_ON_ACCEPT=true
MOVE_TO_INTERVIEW_VOICE=false
PORT=8080

# Тиры: бот создаёт/привязывает роли и каналы автоматически.
# TIER_GUILD_ID по умолчанию берётся из GUILD_ID.
TIER_GUILD_ID=
# ID можно указать, чтобы привязать существующие роли; иначе бот найдёт их по названию или создаст.
TIERCHECK_ROLE_ID=
TIER_1_ROLE_ID=
TIER_2_ROLE_ID=
TIER_3_ROLE_ID=

# Необязательно: {"<guild_id>": <backup_channel_id>} — канал с обязательной копией.
DISCORD_BACKUP_CHANNEL_IDS=

# Railway: mount persistent volume at /app/data before relying on SQLite storage
DATABASE_PATH=data/bot.db
